# 依赖与构建产物
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/.temp/

# 注意：docs/posts 是 `pnpm sync` 从 Obsidian 库生成的「真副本」，**需要提交**。
# 线上 CI 没有你本地那个 Obsidian 库，只能从仓库里拿内容。

# 系统 / 编辑器
.DS_Store
Thumbs.db
*.log

# 调试时截的预览图（项目根目录下的 png 不入库；站点自己的图片放 docs/public/）
/*.png

# 大体积附件：sync 已经会挡掉（见 SKIP_ASSET_EXT / MAX_ASSET_BYTES），
# 这里再拦一道，防止手动把教材 PDF 拖进 docs/posts 后又把仓库撑爆。
# 教训：111MB 的 PDF 进过一次仓库，push 卡在 20% 反复超时。
docs/posts/**/*.pdf
docs/posts/**/*.doc
docs/posts/**/*.docx
docs/posts/**/*.ppt
docs/posts/**/*.pptx
docs/posts/**/*.xls
docs/posts/**/*.xlsx
docs/posts/**/*.zip
docs/posts/**/*.7z
docs/posts/**/*.rar
docs/posts/**/*.exe

# 手写体字体原件（由 scripts/fonts-tools/prepare-fonts.py 生成，不入库）
scripts/fonts/*.woff2
scripts/fonts/.work/
