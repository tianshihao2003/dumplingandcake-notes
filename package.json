{
  "name": "dumplingandcake-notes",
  "version": "0.1.0",
  "private": true,
  "description": "团子和蛋糕的学习笔记（VitePress 自定义主题）",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-notes.mjs && node scripts/optimize-images.mjs",
    "dev": "pnpm sync && vitepress dev docs",
    "build": "pnpm sync && vitepress build docs && pagefind --site docs/.vitepress/dist && node scripts/generate-feed.mjs",
    "serve": "vitepress serve docs",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@waline/client": "^3.16.2",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "mermaid": "^10.9.8",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
